  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "kiro",
    "provider"
  ],
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "main": "./extension.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satiyap/pi-kiro-api.git"
  },
  "homepage": "https://github.com/satiyap/pi-kiro-api#readme",
  "bugs": "https://github.com/satiyap/pi-kiro-api/issues",
  "author": "satiyap",
  "files": [
    "extension.ts",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.2",
    "@types/node": "^26.0.1",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
